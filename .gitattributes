# Normalize text files and enforce LF on shell scripts, assembly, and linker scripts
* text=auto

*.sh text eol=lf
*.S text eol=lf
*.s text eol=lf
*.c text eol=lf
*.h text eol=lf
*.ld text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary assets
*.EFI binary
*.efi binary
*.fd binary
*.pf2 binary
*.img binary
*.iso binary
*.o binary
*.elf binary
